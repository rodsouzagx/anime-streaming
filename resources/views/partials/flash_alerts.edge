<div class="pointer-events-none fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4">
  @if(flashMessages?.has('error'))
    @!ui.toast({ variant: 'error', message: flashMessages.get('error') })
  @end
  @if(flashMessages?.has('success'))
    @!ui.toast({ variant: 'success', message: flashMessages.get('success') })
  @end
</div>
