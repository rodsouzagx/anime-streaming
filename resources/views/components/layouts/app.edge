@let(nav = [
  { label: 'Catálogo', route: 'animes.index', icon: 'lucide:clapperboard' },
  { label: 'Painel', route: 'admin.dashboard', icon: 'lucide:shield', adminOnly: true },
])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Anime Streaming` : 'Anime Streaming' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <header class="border-b border-border bg-background">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6">
        <a href="/animes" class="font-display text-2xl font-bold tracking-wide uppercase">
          Anime<span class="text-accent">Streaming</span>
        </a>

        <nav class="flex h-full items-center gap-6">
          @each(item in nav)
            @if(!item.adminOnly || auth.user?.role === 'admin')
              @navLink({
                route: item.route,
                class:
                  'flex h-full items-center gap-2 border-b-2 border-transparent text-sm font-medium text-muted transition-colors duration-150 hover:text-foreground aria-[current=page]:border-accent aria-[current=page]:text-foreground',
              })
                @if(item.icon)
                  @svg(item.icon, { width: 16, height: 16 })
                @end

                <span>{{ item.label }}</span>
              @end
            @end
          @end
        </nav>

        <div class="ml-auto flex items-center gap-3">
          @if(auth.user)
            <span class="hidden type-meta sm:inline">
              {{ auth.user.fullName || auth.user.email }}
            </span>
            @form({ route: 'session.destroy', method: 'POST' })
              @ui.button({ type: 'submit', variant: 'ghost', size: 'sm' })
                @svg('lucide:log-out', { width: 15, height: 15 })
                <span>Sair</span>
              @end
            @end
          @else
            @ui.button({ href: '/login', variant: 'ghost', size: 'sm' })
              Entrar
            @end
            @ui.button({ href: '/signup', size: 'sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>

    <main>{{{ await $slots.main() }}}</main>
    @include('partials/flash_alerts')
  </body>
</html>
