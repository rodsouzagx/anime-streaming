{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [
  { label: 'Catálogo', route: 'animes.index', icon: 'lucide:clapperboard' },
  { label: 'Painel', route: 'admin.dashboard', icon: 'lucide:shield', adminOnly: true },
])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Anime Streaming` : 'Anime Streaming' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
          @if(auth.user)
            @form({ route: 'session.destroy', method: 'POST' })
              <button type="submit" class="btn btn--secondary btn--sm">
                @svg('lucide:log-out', { width: 15, height: 15 })
                
                Sair

              </button>
            @end
          @else
            <a href="/login" class="btn btn--secondary btn--sm">Entrar</a>
            <a href="/signup" class="btn btn--sm">Criar conta</a>
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @if(!item.adminOnly || auth.user?.role === 'admin')
            @navLink({ route: item.route, class: 'subnav__item' })
              @if(item.icon)
                @svg(item.icon, { width: 14, height: 14 })
              @end
              {{ item.label }}
            @end
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
