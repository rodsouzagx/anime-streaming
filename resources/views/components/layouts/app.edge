@let(nav = [
  { label: 'Início', route: 'home', icon: 'lucide:house' },
  { label: 'Catálogo', route: 'animes.index', icon: 'lucide:clapperboard' },
  { label: 'Painel', route: 'admin.dashboard', icon: 'lucide:shield', adminOnly: true },
])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Anime Streaming` : 'Anime Streaming' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <header class="border-b border-border bg-background">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6">
        <a href="/" class="font-display text-2xl font-bold tracking-wide uppercase">
          Anime<span class="text-accent">Streaming</span>
        </a>

        <nav class="flex h-full items-center gap-6">
          @each(item in nav)
            @if(!item.adminOnly || auth?.user?.role === 'admin')
              @navLink({
                route: item.route,
                class:
                  'flex h-full items-center gap-2 border-b-2 border-transparent text-sm font-medium text-muted transition-colors duration-150 hover:text-foreground aria-[current=page]:border-accent aria-[current=page]:text-foreground',
              })
                @if(item.icon)
                  @svg(item.icon, { width: 16, height: 16 })
                @end

                <span>{{ item.label }}</span>
              @end
            @end
          @end
        </nav>

        <div class="ml-auto flex items-center gap-3">
          @if(auth?.user)
            <a
              href="/profile"
              class="flex items-center gap-2 rounded-md px-2 py-1 transition-colors duration-150 hover:bg-surface"
            >
              @!ui.avatar({ user: auth.user, size: 'sm' })
              <span class="hidden text-sm font-medium text-muted sm:inline">
                {{ auth.user.fullName || auth.user.email }}
              </span>
            </a>
            @form({ route: 'session.destroy', method: 'POST' })
              @ui.button({ type: 'submit', variant: 'ghost', size: 'sm' })
                @svg('lucide:log-out', { width: 15, height: 15 })
                <span>Sair</span>
              @end
            @end
          @else
            @ui.button({ href: '/login', variant: 'ghost', size: 'sm' })
              Entrar
            @end
            @ui.button({ href: '/signup', size: 'sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>

    <main class="flex-1">{{{ await $slots.main() }}}</main>
    <footer class="mt-16 border-t border-border">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:flex-row sm:items-start sm:justify-between sm:px-6"
      >
        <div class="max-w-sm">
          <a href="/" class="font-display text-xl font-bold tracking-wide uppercase">
            Anime<span class="text-accent">Streaming</span>
          </a>
          <p class="mt-2 type-meta">
            Plataforma de streaming de animes desenvolvida como projeto acadêmico na UFRRJ.
          </p>
        </div>

        <nav class="flex gap-6 text-sm" aria-label="Rodapé">
          <a href="/" class="text-muted transition-colors duration-150 hover:text-accent">Início</a>
          <a href="/animes" class="text-muted transition-colors duration-150 hover:text-accent">
            Catálogo
          </a>
          <a
            href="https://github.com/rodsouzagx/anime-streaming"
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-1.5 text-muted transition-colors duration-150 hover:text-accent"
          >
            @svg('lucide:github', { width: 15, height: 15 })
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </footer>
    @include('partials/flash_alerts')
  </body>
</html>
