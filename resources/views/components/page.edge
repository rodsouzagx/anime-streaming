{{--
  Moldura das páginas: título e descrição opcionais, e ações
  (botões, links) passadas pelo slot `actions`.
--}}
@let(pageTitle = $props.get('title'))
@let(pageDescription = $props.get('description'))

<div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6">
  @if(pageTitle || pageDescription || $slots.actions)
    <header class="mb-8 flex flex-wrap items-end justify-between gap-4 motion-safe:animate-fade-up">
      <div>
        @if(pageTitle)
          <h1 class="type-h1">{{ pageTitle }}</h1>
        @end
        @if(pageDescription)
          <p class="mt-1 type-meta">{{ pageDescription }}</p>
        @end
      </div>
      @if($slots.actions)
        <div class="flex items-center gap-3">{{{ await $slots.actions() }}}</div>
      @end
    </header>
  @end
  {{{ await $slots.main() }}}
</div>
