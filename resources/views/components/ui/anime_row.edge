@let(title = $props.get('title'))
@let(animes = $props.get('animes') ?? [])
@let(href = $props.get('href'))

<section
  class="group/row py-10"
  x-data="{
    canPrev: false,
    canNext: false,
    update() {
    const track = this.$refs.track
    this.canPrev = track.scrollLeft > 4
    this.canNext = track.scrollLeft + track.clientWidth < track.scrollWidth - 4
    },
    scroll(direction) {
    const track = this.$refs.track
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: reduceMotion ? 'auto' : 'smooth' })
    },
    }"
  x-init="update()"
  x-on:resize.window="update()"
>
  <div class="flex items-end justify-between gap-4">
    <h2 class="type-h2">{{ title }}</h2>
    @if(href)
      <a
        href="{{ href }}"
        class="text-sm font-medium text-muted transition-colors duration-150 hover:text-accent"
      >
        Ver todos
      </a>
    @end
  </div>

  <div class="relative mt-4">
    <div
      x-ref="track"
      x-on:scroll.passive="update()"
      class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 scrollbar-none sm:-mx-6 sm:px-6"
    >
      @each(anime in animes)
        <div class="w-36 shrink-0 snap-start sm:w-44">
          @!ui.animeCard({ anime })
        </div>
      @end
    </div>
    {{-- Seta para a esquerda --}}
    <button
      type="button"
      x-show="canPrev"
      x-cloak
      x-on:click="scroll(-1)"
      aria-label="Ver anteriores"
      class="absolute top-0 bottom-4 -left-4 hidden w-16 items-center justify-start bg-linear-to-r from-background to-transparent pl-2 opacity-0 transition-opacity duration-150 group-hover/row:opacity-100 focus-visible:opacity-100 sm:-left-6 sm:flex"
    >
      <span
        class="grid size-10 place-items-center rounded-full border border-border bg-surface/90 shadow-lg transition-transform duration-150 ease-smooth hover:scale-110"
      >
        @svg('lucide:chevron-left', { width: 20, height: 20 })
      </span>
    </button>
    {{-- Seta para a direita --}}
    <button
      type="button"
      x-show="canNext"
      x-cloak
      x-on:click="scroll(1)"
      aria-label="Ver próximos"
      class="absolute top-0 -right-4 bottom-4 hidden w-16 items-center justify-end bg-linear-to-l from-background to-transparent pr-2 opacity-0 transition-opacity duration-150 group-hover/row:opacity-100 focus-visible:opacity-100 sm:-right-6 sm:flex"
    >
      <span
        class="grid size-10 place-items-center rounded-full border border-border bg-surface/90 shadow-lg transition-transform duration-150 ease-smooth hover:scale-110"
      >
        @svg('lucide:chevron-right', { width: 20, height: 20 })
      </span>
    </button>
  </div>
</section>
