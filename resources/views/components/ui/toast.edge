@let(variant = $props.get('variant') ?? 'success')
@let(message = $props.get('message'))

<div
  x-data="{ show: false }"
  x-init="$nextTick(() => show = true); setTimeout(() => show = false, 5000)"
  x-show="show"
  x-cloak
  x-transition:enter="transition duration-300 ease-smooth"
  x-transition:enter-start="-translate-y-2 opacity-0"
  x-transition:leave="transition duration-200 ease-smooth"
  x-transition:leave-end="-translate-y-2 opacity-0"
  role="{{ variant === 'error' ? 'alert' : 'status' }}"
  class="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-lg border border-border bg-surface-2 px-4 py-3 shadow-xl shadow-black/40"
>
  @if(variant === 'error')
    @svg('lucide:circle-alert', {
      width: 18,
      height: 18,
      class: 'mt-0.5 shrink-0 text-red-400',
    })
  @else
    @svg('lucide:circle-check', {
      width: 18,
      height: 18,
      class: 'mt-0.5 shrink-0 text-accent',
    })
  @end

  <p class="flex-1 text-sm font-medium">{{ message }}</p>

  <button
    type="button"
    x-on:click="show = false"
    aria-label="Fechar aviso"
    class="shrink-0 text-muted transition-colors duration-150 hover:text-foreground"
  >
    @svg('lucide:x', { width: 16, height: 16 })
  </button>
</div>
