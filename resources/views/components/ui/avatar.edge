@let(user = $props.get('user'))
@let(size = $props.get('size') ?? 'md')
@let(sizes = {
  sm: 'size-8 text-xs',
  md: 'size-10 text-sm',
  lg: 'size-28 text-3xl',
})
@if(user.avatarPath)
  <img
    src="/{{ user.avatarPath }}"
    alt=""
    class="{{ sizes[size] }} shrink-0 rounded-full object-cover ring-1 ring-border"
  />
@else
  <span
    class="{{ sizes[size] }} grid shrink-0 place-items-center rounded-full bg-surface-2 font-semibold text-muted ring-1 ring-border"
  >
    {{ user.initials }}
  </span>
@end
