@let(name = $props.get('name'))
@let(label = $props.get('label'))
@let(type = $props.get('type') ?? 'text')
@let(value = $props.get('value') ?? old(name) ?? '')
@let(placeholder = $props.get('placeholder') ?? '')
@let(hint = $props.get('hint'))
@let(required = $props.get('required'))
@let(accept = $props.get('accept'))
@let(autocomplete = $props.get('autocomplete'))

<div class="flex flex-col gap-1.5">
  @if(label)
    <label for="{{ name }}" class="text-sm font-medium text-foreground">
      {{ label }}
      @if(required)
        <span class="text-accent">*</span>
      @end
    </label>
  @end

    <input
    id="{{ name }}"
    name="{{ name }}"
    type="{{ type }}"
    @if(type !== 'file' && type !== 'password')
      value="{{ value }}"
    @end
    @if(autocomplete)
      autocomplete="{{ autocomplete }}"
    @end
    placeholder="{{ placeholder }}"
    @if(accept)
      accept="{{ accept }}"
    @end
    class="w-full rounded-md border border-border bg-surface px-3 text-sm text-foreground transition-colors duration-150 ease-smooth placeholder:text-muted hover:border-muted/40 focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none {{ type === 'file' ? 'py-2 file:mr-3 file:rounded file:border-0 file:bg-surface-2 file:px-3 file:py-1 file:text-sm file:font-medium file:text-foreground' : 'h-10' }}"
  />
  @if(hint)
    <p class="type-meta">{{ hint }}</p>
  @end
  @inputError(name)
    @each(message in $messages)
      <p class="text-sm text-red-400">{{ message }}</p>
    @end
  @end
</div>
