@let(name = $props.get('name'))
@let(label = $props.get('label'))
@let(options = $props.get('options') ?? [])
@let(value = $props.get('value') ?? old(name) ?? '')
@let(required = $props.get('required'))

<div class="flex flex-col gap-1.5">
  @if(label)
    <label for="{{ name }}" class="text-sm font-medium text-foreground">
      {{ label }}
      @if(required)
        <span class="text-accent">*</span>
      @end
    </label>
  @end

  <select
    id="{{ name }}"
    name="{{ name }}"
    class="h-10 w-full rounded-md border border-border bg-surface px-3 text-sm text-foreground transition-colors duration-150 ease-smooth hover:border-muted/40 focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none"
  >
    @each(option in options)
      <option
        value="{{ option.value }}"
        {{ String(option.value) === String(value) ? 'selected' : '' }}
        {{ option.disabled ? 'disabled' : '' }}
      >
        {{ option.label }}
      </option>
    @end
  </select>
  @inputError(name)
    @each(message in $messages)
      <p class="text-sm text-red-400">{{ message }}</p>
    @end
  @end
</div>
