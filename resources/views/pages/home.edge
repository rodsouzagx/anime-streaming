@layouts.app({ title: 'Início' })
  {{-- Destaques --}}
  @if(featured.length)
    <section
      x-data="{
        current: 0,
        total: {{ featured.length }},
        timer: null,
        start() { this.timer = setInterval(() => this.next(), 7000) },
        next() { this.current = (this.current + 1) % this.total },
        go(index) { this.current = index; clearInterval(this.timer); this.start() },
        }"
      x-init="start()"
      class="relative h-[70vh] min-h-110 overflow-hidden"
    >
      @each((anime, index) in featured)
        <div
          x-show="current === {{ index }}"
          {{ index ? 'x-cloak' : '' }}
          x-transition:enter="transition-opacity duration-700 ease-smooth"
          x-transition:enter-start="opacity-0"
          x-transition:leave="transition-opacity duration-700 ease-smooth"
          x-transition:leave-end="opacity-0"
          class="absolute inset-0"
        >
          @if(anime.bannerPath)
            <img
              src="/{{ anime.bannerPath }}"
              alt=""
              class="absolute inset-0 size-full object-cover object-[center_30%]"
            />
          @else
            <img
              src="/{{ anime.coverPath }}"
              alt=""
              class="absolute inset-0 size-full scale-110 object-cover opacity-40 blur-2xl"
            />
          @end

          <div
            class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
          ></div>
          <div
            class="absolute inset-0 bg-linear-to-r from-background/90 via-background/30 to-transparent"
          ></div>

          <div
            class="relative mx-auto flex h-full max-w-7xl flex-col justify-end px-4 pb-20 sm:px-6"
          >
            <p class="type-caption text-accent">Em destaque</p>
            <h1 class="mt-2 max-w-3xl type-display">{{ anime.title }}</h1>
            <p class="mt-3 type-meta">
              {{ anime.status === 'ongoing' ? 'Em lançamento' : 'Finalizado' }}
              @if(anime.releaseYear)
                ·
                {{ anime.releaseYear }}
              @end
              @if(anime.genres.length)
                ·
                {{ anime.genres.map((genre) => genre.name).join(', ') }}
              @end
            </p>
            <p class="mt-4 line-clamp-3 max-w-xl type-body text-foreground/80">
              {{ anime.synopsis }}
            </p>
            <div class="mt-6">
              @ui.button({ href: `/animes/${anime.slug}`, size: 'lg' })
                @svg('lucide:play', { width: 18, height: 18 })
                <span>Ver anime</span>
              @end
            </div>
          </div>
        </div>
      @end
      @if(featured.length > 1)
        <div class="absolute right-4 bottom-8 flex gap-2 sm:right-6">
          @each((anime, index) in featured)
            <button
              type="button"
              x-on:click="go({{ index }})"
              :class="current === {{ index }} ? 'w-8 bg-accent' : 'w-3 bg-foreground/30 hover:bg-foreground/60'"
              class="h-1.5 rounded-full transition-all duration-300 ease-smooth"
              aria-label="Ver destaque {{ index + 1 }}: {{ anime.title }}"
            ></button>
          @end
        </div>
      @end
    </section>
  @end
  {{-- Fileiras --}}
  @if(recent.length)
    @!ui.animeRow({ title: 'Novidades', animes: recent, href: '/animes' })
  @end
  @each(genre in genres)
    @!ui.animeRow({ title: genre.name, animes: genre.animes })
  @end

  <div class="h-16"></div>
@end
