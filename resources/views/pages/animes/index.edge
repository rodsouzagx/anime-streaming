@layouts.app({ title: 'Catálogo' })
  @page({ title: 'Catálogo', description: 'Todos os animes disponíveis na plataforma.' })
    <form method="GET" action="/animes">
      <input type="search" name="q" value="{{ search }}" placeholder="Buscar anime pelo nome..." />
      @ui.button({ type: 'submit' })
        Buscar
      @end
    </form>
    @if(search)
      <p>
        {{ animes.length }}
        resultado(s) para "{{ search }}".
        <a href="/animes">Limpar busca</a>
      </p>
    @end
    @if(animes.length === 0)
      <p>Nenhum anime encontrado.</p>
    @end

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      @each(anime in animes)
        @!ui.animeCard({ anime })
      @end
    </div>
  @end
@end
