@layouts.app({ title: 'Página não encontrada' })
  <div
    class="mx-auto flex max-w-7xl flex-col items-start justify-center px-4 py-24 sm:px-6 sm:py-32 motion-safe:animate-fade-up"
  >
    <p class="type-caption text-accent">Erro 404</p>
    <h1 class="mt-3 type-display">Página não encontrada</h1>
    <p class="mt-4 max-w-md type-body text-muted">
      O endereço pode estar errado, ou esse conteúdo foi removido da plataforma.
    </p>
    <div class="mt-8">
      @ui.button({ href: '/animes', size: 'lg' })
        @svg('lucide:arrow-left', { width: 18, height: 18 })
        <span>Voltar ao catálogo</span>
      @end
    </div>
  </div>
@end
