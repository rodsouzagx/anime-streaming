@layouts.app({ title: 'Algo deu errado' })
  <div
    class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-7xl flex-col items-start justify-center px-4 sm:px-6 motion-safe:animate-fade-up"
  >
    <p class="type-caption text-red-400">Erro 500</p>
    <h1 class="mt-3 type-display">Algo deu errado</h1>
    <p class="mt-4 max-w-md type-body text-muted">
      Tivemos um problema do nosso lado. Tente de novo em alguns instantes.
    </p>
    <div class="mt-8">
      @ui.button({ href: '/animes', size: 'lg' })
        @svg('lucide:arrow-left', { width: 18, height: 18 })
        <span>Voltar ao catálogo</span>
      @end
    </div>
  </div>
@end
