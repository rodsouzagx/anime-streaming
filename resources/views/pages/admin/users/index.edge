@layouts.app({ title: 'Usuários' })
  @page({ title: 'Usuários', description: `${users.length} usuário(s) cadastrado(s).` })
    <div class="overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-left text-sm">
        <thead class="bg-surface">
          <tr>
            <th class="px-4 py-3 type-caption">Usuário</th>
            <th class="px-4 py-3 type-caption">Papel</th>
            <th class="px-4 py-3 type-caption">Cadastrado em</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          @each(user in users)
            <tr class="transition-colors duration-150 hover:bg-surface/60">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  @!ui.avatar({ user, size: 'md' })
                  <div class="min-w-0">
                    <p class="truncate font-semibold">{{ user.fullName ?? 'Sem nome' }}</p>
                    <p class="truncate type-meta">{{ user.email }}</p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3">
                @if(user.role === 'admin')
                  <span class="rounded-md bg-accent/10 px-2 py-1 text-xs font-medium text-accent">
                    Administrador
                  </span>
                @else
                  <span class="rounded-md bg-surface-2 px-2 py-1 text-xs font-medium text-muted">
                    Usuário
                  </span>
                @end
              </td>
              <td class="px-4 py-3 type-meta">{{ user.createdAt.toFormat('dd/MM/yyyy') }}</td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @end
@end
