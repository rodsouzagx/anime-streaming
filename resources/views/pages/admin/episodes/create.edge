@layouts.app({ title: 'Adicionar episódio' })
  @page({
    title: 'Adicionar episódio',
    description: `${season.anime.title} · Temporada ${season.number}`,
  })
    <form
      method="POST"
      action="/admin/seasons/{{ season.id }}/episodes"
      enctype="multipart/form-data"
      class="flex max-w-3xl flex-col gap-6 rounded-lg border border-border bg-surface/50 p-6"
    >
      {{ csrfField() }}
      <div class="grid gap-6 sm:grid-cols-[120px_1fr]">
        @!ui.input({
          name: 'number',
          label: 'Número',
          type: 'number',
          required: true,
          value: season.episodes.length + 1,
        })
        @!ui.input({
          name: 'title',
          label: 'Título',
          required: true,
          placeholder: 'Ex: O fim da jornada',
        })
      </div>
      @!ui.textarea({ name: 'synopsis', label: 'Sinopse', rows: 3, hint: 'Opcional.' })
      @!ui.input({
        name: 'video',
        label: 'Vídeo',
        type: 'file',
        accept: 'video/mp4,video/webm',
        required: true,
        hint: 'mp4 ou webm, até 500 MB. O envio pode levar alguns segundos.',
      })

      <div class="flex justify-end gap-3 border-t border-border pt-6">
        @ui.button({ href: `/admin/animes/${season.animeId}`, variant: 'ghost' })
          Cancelar
        @end
        @ui.button({ type: 'submit' })
          Adicionar episódio
        @end
      </div>
    </form>
  @end
@end
