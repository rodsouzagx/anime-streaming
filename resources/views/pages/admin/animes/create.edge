@layouts.app({ title: 'Cadastrar anime' })
  @page({
    title: 'Cadastrar anime',
    description:
      'Temporadas e episódios são adicionados depois, na página de gerenciamento.',
  })
    <form
      method="POST"
      action="/admin/animes"
      enctype="multipart/form-data"
      class="flex max-w-3xl flex-col gap-6 rounded-lg border border-border bg-surface/50 p-6"
    >
      {{ csrfField() }}
      @!ui.input({
        name: 'title',
        label: 'Título',
        required: true,
        placeholder: 'Ex: Frieren',
      })
      @!ui.textarea({ name: 'synopsis', label: 'Sinopse', required: true, rows: 5 })

      <div class="grid gap-6 sm:grid-cols-2">
        @!ui.select({
          name: 'status',
          label: 'Status',
          required: true,
          options: [
            { value: 'ongoing', label: 'Em lançamento' },
            { value: 'finished', label: 'Finalizado' },
          ],
        })
        @!ui.select({
          name: 'ageRating',
          label: 'Classificação indicativa',
          options: [
            { value: '', label: 'Não informada' },
            { value: 'L', label: 'Livre' },
            { value: '10', label: '10 anos' },
            { value: '12', label: '12 anos' },
            { value: '14', label: '14 anos' },
            { value: '16', label: '16 anos' },
            { value: '18', label: '18 anos' },
          ],
        })
        @!ui.input({
          name: 'releaseYear',
          label: 'Ano de lançamento',
          type: 'number',
          placeholder: 'Ex: 2023',
        })
        @!ui.input({ name: 'studio', label: 'Estúdio', placeholder: 'Ex: Madhouse' })
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        @!ui.input({
          name: 'cover',
          label: 'Capa',
          type: 'file',
          accept: 'image/*',
          required: true,
          hint: 'Formato pôster (vertical). jpg, png ou webp, até 5 MB.',
        })
        @!ui.input({
          name: 'banner',
          label: 'Banner',
          type: 'file',
          accept: 'image/*',
          hint: 'Opcional. Imagem larga, exibida no topo da página do anime.',
        })
      </div>

      <div class="flex justify-end gap-3 border-t border-border pt-6">
        @ui.button({ href: '/admin/animes', variant: 'ghost' })
          Cancelar
        @end
        @ui.button({ type: 'submit' })
          Cadastrar anime
        @end
      </div>
    </form>
  @end
@end
