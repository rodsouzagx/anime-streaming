@layouts.app({ title: anime.title })
  @page()
    <p><a href="/admin/animes">← Voltar para animes</a></p>

    <h1>{{ anime.title }}</h1>
    <img src="/{{ anime.coverPath }}" alt="" width="120" />

    <h2>Temporadas</h2>
    @each(season in anime.seasons)
      <div style="margin-bottom: 24px;">
        <h3>Temporada {{ season.number }}{{ season.title ? ': ' + season.title : '' }}</h3>

        <ul>
          @each(episode in season.episodes)
            <li>
              
              Episódio
              {{ episode.number }}
              :
              {{ episode.title }}
              <form
                method="POST"
                action="/admin/episodes/{{ episode.id }}?_method=DELETE"
                style="display: inline;"
                onsubmit="return confirm('Remover este episódio?')"
              >
                {{ csrfField() }}
                <button type="submit">Remover</button>
              </form>
            </li>
          @end
        </ul>

        <p><a href="/admin/seasons/{{ season.id }}/episodes/create">+ Adicionar episódio</a></p>

        <form
          method="POST"
          action="/admin/seasons/{{ season.id }}?_method=DELETE"
          onsubmit="return confirm('Remover esta temporada e todos os episódios dela?')"
        >
          {{ csrfField() }}
          <button type="submit">Remover temporada</button>
        </form>
      </div>
    @end

    <h2>Adicionar temporada</h2>

    <form method="POST" action="/admin/animes/{{ anime.id }}/seasons">
      {{ csrfField() }}
      <p>
        <label>Número *</label>
        <br />
        <input type="number" name="number" min="1" value="{{ anime.seasons.length + 1 }}" />
      </p>

      <p>
        <label>Título (opcional)</label>
        <br />
        <input type="text" name="title" />
      </p>

      <button type="submit">Adicionar temporada</button>
    </form>
  @end
@end
