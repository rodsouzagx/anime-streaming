@layouts.app({ title: 'Animes' })
  @page()
    <h1>Animes</h1>
    <p><a href="/admin/animes/create">+ Cadastrar anime</a></p>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Status</th>
          <th>Cadastrado em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        @each(anime in animes)
          <tr>
            <td>{{ anime.id }}</td>
            <td>
              <img src="/{{ anime.coverPath }}" alt="" width="40" />
              {{ anime.title }}
            </td>
            <td>{{ anime.status === 'ongoing' ? 'Em lançamento' : 'Finalizado' }}</td>
            <td>{{ anime.createdAt.toFormat('dd/MM/yyyy') }}</td>
            <td>
              <form
                method="POST"
                action="/admin/animes/{{ anime.id }}?_method=DELETE"
                onsubmit="return confirm('Tem certeza que deseja remover este anime?')"
              >
                {{ csrfField() }}
                <button type="submit">Remover</button>
              </form>
            </td>
          </tr>
        @end
      </tbody>
    </table>
  @end
@end
