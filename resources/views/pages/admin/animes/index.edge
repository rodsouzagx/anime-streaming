@layouts.app({ title: 'Animes' })
  @page({
    title: 'Animes',
    description: `${animes.length} ${animes.length === 1 ? 'anime cadastrado' : 'animes cadastrados'}.`,
  })
    @slot('actions')
      @ui.button({ href: '/admin/animes/create' })
        @svg('lucide:plus', { width: 16, height: 16 })
        <span>Cadastrar anime</span>
      @end
    @end

    <form method="GET" action="/admin/animes" class="mb-4 flex max-w-lg items-start gap-2">
      <div class="flex-1">
        @!ui.input({
          name: 'q',
          type: 'search',
          value: search,
          placeholder: 'Buscar anime pelo nome...',
        })
      </div>
      @ui.button({ type: 'submit', variant: 'secondary' })
        @svg('lucide:search', { width: 16, height: 16 })
        <span>Buscar</span>
      @end
    </form>

    <p class="mb-6 flex items-center gap-2 type-meta">
      @svg('lucide:star', { width: 14, height: 14, class: 'text-accent' })
      {{ featuredCount }}
       de
      {{ featuredSlots }}
       posições de destaque ocupadas.

    </p>
    @if(search)
      <p class="mb-6 type-meta">
        {{ animes.length }}
        {{ animes.length === 1 ? 'resultado' : 'resultados' }}
        para "<span class="text-foreground">{{ search }}</span>".
        <a href="/admin/animes" class="ml-2 text-accent hover:underline">Limpar busca</a>
      </p>
    @end
    @if(animes.length === 0)
      <div class="rounded-lg border border-dashed border-border py-16 text-center">
        @if(search)
          <p class="type-h3">Nenhum anime encontrado</p>
          <p class="mt-1 type-meta">Tente buscar por outro nome.</p>
        @else
          <p class="type-h3">Nenhum anime cadastrado</p>
          <p class="mt-1 type-meta">Comece cadastrando o primeiro anime da plataforma.</p>
        @end
      </div>
    @else
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface">
            <tr>
              <th class="px-4 py-3 type-caption">Anime</th>
              <th class="px-4 py-3 type-caption">Status</th>
              <th class="px-4 py-3 type-caption">Cadastrado em</th>
              <th class="px-4 py-3 text-right type-caption">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            @each(anime in animes)
              <tr class="transition-colors duration-150 hover:bg-surface/60">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <img
                      src="/{{ anime.coverPath }}"
                      alt=""
                      class="h-14 w-10 shrink-0 rounded object-cover"
                    />
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <p class="truncate font-semibold">{{ anime.title }}</p>
                        @if(anime.featuredPosition)
                          <span
                            class="flex shrink-0 items-center gap-1 rounded-md bg-accent/10 px-1.5 py-0.5 text-xs font-medium text-accent"
                          >
                            @svg('lucide:star', { width: 12, height: 12 })
                            
                            Destaque
                            {{ anime.featuredPosition }}
                          </span>
                        @end
                      </div>
                      <a href="/animes/{{ anime.slug }}" class="type-meta hover:text-accent">
                        /animes/{{ anime.slug }}
                      </a>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">
                  @if(anime.status === 'ongoing')
                    <span class="rounded-md bg-accent/10 px-2 py-1 text-xs font-medium text-accent">
                      Em lançamento
                    </span>
                  @else
                    <span class="rounded-md bg-surface-2 px-2 py-1 text-xs font-medium text-muted">
                      Finalizado
                    </span>
                  @end
                </td>
                <td class="px-4 py-3 type-meta">{{ anime.createdAt.toFormat('dd/MM/yyyy') }}</td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2">
                    @ui.button({
                      href: `/admin/animes/${anime.id}`,
                      variant: 'secondary',
                      size: 'sm',
                    })
                      Gerenciar
                    @end

                    <form
                      method="POST"
                      action="/admin/animes/{{ anime.id }}?_method=DELETE"
                      onsubmit="return confirm('Remover este anime, com todas as temporadas e episódios?')"
                    >
                      {{ csrfField() }}
                      @ui.button({ type: 'submit', variant: 'danger', size: 'sm' })
                        Remover
                      @end
                    </form>
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @end
  @end
@end
