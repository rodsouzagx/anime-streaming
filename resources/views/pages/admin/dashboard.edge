@let(cards = [
  {
    label: 'Animes',
    value: stats.animes,
    detail: `${stats.episodes} episódio(s)`,
    href: '/admin/animes',
    icon: 'lucide:clapperboard',
  },
  {
    label: 'Destaques',
    value: stats.featured,
    detail: 'de 5 posições',
    href: '/admin/featured',
    icon: 'lucide:star',
  },
  { label: 'Usuários', value: stats.users, href: '/admin/users', icon: 'lucide:users' },
])
@layouts.app({ title: 'Painel' })
  @page({ title: 'Painel', description: 'Visão geral da plataforma.' })
    @slot('actions')
      @ui.button({ href: '/admin/animes/create' })
        @svg('lucide:plus', { width: 16, height: 16 })
        <span>Cadastrar anime</span>
      @end
    @end

    <div class="grid gap-4 sm:grid-cols-2">
      @each(card in cards)
        <a
          href="{{ card.href }}"
          class="group flex flex-col gap-4 rounded-lg border border-border bg-surface p-5 transition-colors duration-150 hover:border-accent/50"
        >
          <div class="flex items-center justify-between">
            <span class="type-caption">{{ card.label }}</span>
            @svg(card.icon, {
              width: 18,
              height: 18,
              class: 'text-muted transition-colors group-hover:text-accent',
            })
          </div>
          <div>
            <span class="block font-display text-5xl font-bold">{{ card.value }}</span>
            @if(card.detail)
              <span class="type-meta">{{ card.detail }}</span>
            @end
          </div>
        </a>
      @end
    </div>
  @end
@end
