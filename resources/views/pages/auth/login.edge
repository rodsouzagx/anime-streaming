@layouts.auth({ title: 'Entrar' })
  <h1 class="type-h1">Entrar</h1>
  <p class="mt-1 type-meta">Bem-vindo de volta. Entre para continuar assistindo.</p>
  @form({ route: 'session.store', method: 'POST', class: 'mt-8 flex flex-col gap-5' })
    @!ui.input({
      name: 'email',
      label: 'E-mail',
      type: 'email',
      autocomplete: 'username',
      placeholder: 'voce@exemplo.com',
    })
    @!ui.input({
      name: 'password',
      label: 'Senha',
      type: 'password',
      autocomplete: 'current-password',
      placeholder: '••••••••',
    })
    <div class="mt-2">
      @ui.button({ type: 'submit', size: 'lg', block: true })
        Entrar
      @end
    </div>
  @end

  <p class="mt-6 text-center type-meta">
    Ainda não tem uma conta?
    <a href="/signup" class="font-medium text-accent hover:underline">Criar conta</a>
  </p>
@end
