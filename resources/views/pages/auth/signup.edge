@layouts.auth({ title: 'Criar conta' })
  <h1 class="type-h1">Criar conta</h1>
  <p class="mt-1 type-meta">Leva menos de um minuto.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
  })
    @!ui.input({
      name: 'fullName',
      label: 'Nome',
      autocomplete: 'name',
      placeholder: 'Como você quer ser chamado',
    })
    @!ui.input({
      name: 'email',
      label: 'E-mail',
      type: 'email',
      autocomplete: 'email',
      placeholder: 'voce@exemplo.com',
    })
    @!ui.input({
      name: 'password',
      label: 'Senha',
      type: 'password',
      autocomplete: 'new-password',
      placeholder: '••••••••',
    })
    @!ui.input({
      name: 'passwordConfirmation',
      label: 'Confirme a senha',
      type: 'password',
      autocomplete: 'new-password',
      placeholder: '••••••••',
    })
    <div class="mt-2">
      @ui.button({ type: 'submit', size: 'lg', block: true })
        Criar conta
      @end
    </div>
  @end

  <p class="mt-6 text-center type-meta">
    Já tem uma conta?
    <a href="/login" class="font-medium text-accent hover:underline">Entrar</a>
  </p>
@end
